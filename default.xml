<?xml version="1.0" encoding="UTF-8"?>

<manifest>

  <!-- remote servers to query -->
  <remote name="openembedded"    alias="origin"  fetch="https://git.openembedded.org/" />
  <remote name="yocto"           alias="origin"  fetch="https://git.yoctoproject.org/" />
  <remote name="toolchain"       alias="origin"  fetch="https://github.com/kraj" />

  <!-- YOCTO & OE -->

  <!-- OpenEmbedded core layer and feature supportive layer -->
  <project name="openembedded-core"    path="openembedded-core"    remote="openembedded"  revision="whinlatter"  upstream="whinlatter" />
  <project name="bitbake"              path="bitbake"              remote="openembedded"  revision="2.16"  upstream="2.16" />
  <project name="meta-openembedded"    path="meta-openembedded"    remote="openembedded"  revision="whinlatter"  upstream="whinlatter" />

  <!-- meta-virtualization -->
  <project name="meta-virtualization"  path="meta-virtualization"  remote="yocto"  revision="whinlatter"  upstream="whinlatter"/>

  <!-- SELinux layer -->
  <project name="meta-selinux"         path="meta-selinux"         remote="yocto"  revision="whinlatter"  upstream="whinlatter"/>

<!-- meta-clang layer -->
  <project name="meta-clang"         path="meta-clang"         remote="toolchain"  revision="whinlatter"  upstream="whinlatter"/>
</manifest>
